# Public application configuration
NEXT_PUBLIC_SITE_URL=https://www.orbit-surplus.com
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only Supabase access
SUPABASE_SERVICE_ROLE_KEY=

# Admin and scheduled-job security
ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=
CRON_SECRET=
REPAIR_API_KEY=

# SMTP delivery
MXROUTE_SMTP_HOST=
MXROUTE_SMTP_PORT=465
MXROUTE_SMTP_USER=
MXROUTE_SMTP_PASS=

# Incoming RFQ part-number links
# IMAP credentials fall back to the SMTP values when they are the same mailbox.
MXROUTE_IMAP_HOST=
MXROUTE_IMAP_PORT=993
MXROUTE_IMAP_USER=
MXROUTE_IMAP_PASS=
ORBIT_PART_LINKS_RECIPIENT=rfq@orbit-surplus.com
# Use an ISO timestamp to avoid processing older messages on first activation.
ORBIT_PART_LINKS_START_AT=
ORBIT_PART_LINKS_BATCH_SIZE=5

# eBay integration
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_REFRESH_TOKEN=

# Cloudflare R2 storage
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=

# WooCommerce integration
WOOCOMMERCE_BASE_URL=
WOOCOMMERCE_CONSUMER_KEY=
WOOCOMMERCE_CONSUMER_SECRET=
